#!/bin/bash
#SBATCH --job-name=prime_task2_job
#SBATCH --time=00:10:00               # 10 minutes max wall-clock time
#SBATCH --mem=16G                     # Total memory requested
#SBATCH --ntasks=4                    # Total number of MPI processes
#SBATCH --cpus-per-task=4             # OpenMP threads per process
#SBATCH --ntasks-per-node=2           # 2 MPI processes per node (spread across 2 nodes)
#SBATCH --partition=defq              # Default CAAS partition

# Load the cluster's Open MPI module
module load openmpi/4.1.5-gcc-11.2.0-ux65npg

# Bind the number of OpenMP threads to the SLURM allocation
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# Run the hybrid program via srun: ./task2 <n> [threads_per_process]
srun ./task2 10000000 $SLURM_CPUS_PER_TASK