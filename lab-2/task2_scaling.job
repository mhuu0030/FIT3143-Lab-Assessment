#!/bin/bash
#SBATCH --job-name=task2_scaling
#SBATCH --time=00:10:00
#SBATCH --mem=16G
#SBATCH --nodes=2
#SBATCH --ntasks=8
#SBATCH --cpus-per-task=8
#SBATCH --partition=defq
#SBATCH --output=task2_scaling_%j.out

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

N_FIXED=30000000
CSV="task2_scaling_results.csv"
echo "Processes,Threads,Total_Workers,Comp_Time,Comm_Time,Serial_Time,Total_Time" > $CSV

# --- Dimension 1: Thread scaling at fixed 2 MPI processes (For Graph 4) ---
echo "=== Scaling Threads (Fixed 2 MPI Processes) ==="
for th in 1 2 4 8; do
    export OMP_NUM_THREADS=$th
    OUT=$(srun --ntasks=2 --cpus-per-task=$th ./task2 $N_FIXED $th)
    comp_t=$(echo "$OUT" | grep "Parallel Computation Time" | awk '{print $5}')
    comm_t=$(echo "$OUT" | grep "MPI Communication Time" | awk '{print $5}')
    serial_t=$(echo "$OUT" | grep "Serial Setup, I/O & Overhead" | awk '{print $7}')
    total_t=$(echo "$OUT" | grep "Total Wall-Clock Time" | awk '{print $5}')
    echo "2,$th,$((2 * th)),$comp_t,$comm_t,$serial_t,$total_t" >> $CSV
done

# --- Dimension 2: Process scaling at fixed 2 OpenMP threads (For Graphs 5 & 7) ---
echo "=== Scaling Processes (Fixed 2 Threads per Process) ==="
for np in 1 2 4 8; do
    export OMP_NUM_THREADS=2
    OUT=$(srun --ntasks=$np --cpus-per-task=2 ./task2 $N_FIXED 2)
    comp_t=$(echo "$OUT" | grep "Parallel Computation Time" | awk '{print $5}')
    comm_t=$(echo "$OUT" | grep "MPI Communication Time" | awk '{print $5}')
    serial_t=$(echo "$OUT" | grep "Serial Setup, I/O & Overhead" | awk '{print $7}')
    total_t=$(echo "$OUT" | grep "Total Wall-Clock Time" | awk '{print $5}')
    echo "$np,2,$((np * 2)),$comp_t,$comm_t,$serial_t,$total_t" >> $CSV
done