#!/bin/bash
#SBATCH --job-name=task2_sweep_job
#SBATCH --time=00:10:00               # CAAS limit: max 10 minutes per job
#SBATCH --mem=16G                     # Memory limit across allocated cores
#SBATCH --ntasks=4                    # 4 MPI processes
#SBATCH --cpus-per-task=4             # 4 OpenMP threads per process (16 total cores)
#SBATCH --ntasks-per-node=2           # 2 processes per node across 2 compute nodes
#SBATCH --partition=defq              # Default CAAS partition
#SBATCH --output=task2_sweep_%j.out   # Standard output log (%j inserts job ID)
#SBATCH --error=task2_sweep_%j.err    # Standard error log

# Load Open MPI module available on CAAS
module load openmpi/4.1.5-gcc-11.2.0-ux65npg

# Bind OpenMP threads directly to SLURM cpus-per-task allocation
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# Compile task2.c if the binary doesn't exist
if [ ! -f ./task2 ]; then
    mpicc -Wall -O2 -fopenmp task2.c -o task2 -lm
fi

# Define CSV output file
CSV_OUT="task2_results.csv"
echo "N,MPI_Processes,OpenMP_Threads,Total_Workers,Comp_Time,Comm_Time,Serial_Time,Total_Time" > $CSV_OUT

echo "=========================================================="
echo "Starting Task 2 Benchmark Sweep (Cyclic + Dynamic)"
echo "Allocation: $SLURM_NTASKS MPI processes, $SLURM_CPUS_PER_TASK OpenMP threads/rank"
echo "=========================================================="

# Internal loop across the 30 specified values of N (10M to 68M with step 2M)
for n in $(seq 10000000 2000000 68000000); do
    echo "[Task 2] Executing N = $n ..."

    # Execute hybrid program via srun and capture terminal output
    RUN_OUTPUT=$(srun ./task2 $n $SLURM_CPUS_PER_TASK)

    # Echo raw run output to the SLURM .out log file
    echo "$RUN_OUTPUT"

    # Extract timed metrics using awk matching task2 performance prints
    comp_t=$(echo "$RUN_OUTPUT" | grep "Parallel Computation Time" | awk '{print $5}')
    comm_t=$(echo "$RUN_OUTPUT" | grep "MPI Communication Time" | awk '{print $5}')
    serial_t=$(echo "$RUN_OUTPUT" | grep "Serial Setup, I/O & Overhead" | awk '{print $7}')
    total_t=$(echo "$RUN_OUTPUT" | grep "Total Wall-Clock Time" | awk '{print $5}')

    # Append row to CSV
    echo "$n,$SLURM_NTASKS,$SLURM_CPUS_PER_TASK,$((SLURM_NTASKS * SLURM_CPUS_PER_TASK)),$comp_t,$comm_t,$serial_t,$total_t" >> $CSV_OUT
done

echo "=========================================================="
echo "Task 2 benchmark complete. Data written to $CSV_OUT"
echo "=========================================================="