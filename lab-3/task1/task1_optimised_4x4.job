#!/bin/bash
#SBATCH --job-name=t1opt_4x4
#SBATCH --partition=defq
#SBATCH --time=00:05:00
#SBATCH --nodes=9
#SBATCH --ntasks=17
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=6
#SBATCH --mem-per-cpu=100M
#SBATCH --output=slurm-t1opt-4x4-%j.out
#SBATCH --error=slurm-t1opt-4x4-%j.err

set -e

module load openmpi/4.1.5-gcc-11.2.0-ux65npg

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_DYNAMIC=FALSE

mpicc -O2 -std=c11 -fopenmp -Wall -Wextra \
    lab3_task1_optimised.c -o task1_optimised

RESULT_DIR="results/task1_optimised/4x4/$SLURM_JOB_ID"
mkdir -p "$RESULT_DIR"

srun ./task1_optimised 4 4 6 8 1000 1 1 2000

mv task1_optimised_base_station.log "$RESULT_DIR"/

for f in task1_optimised_node_*.log; do
    [ -e "$f" ] && mv "$f" "$RESULT_DIR"/
done

cp "slurm-t1opt-4x4-$SLURM_JOB_ID.out" "$RESULT_DIR"/ 2>/dev/null || true
cp "slurm-t1opt-4x4-$SLURM_JOB_ID.err" "$RESULT_DIR"/ 2>/dev/null || true

echo "Results saved to $RESULT_DIR"
