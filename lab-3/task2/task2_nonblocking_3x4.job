#!/bin/bash
#SBATCH --job-name=t2nb_3x4
#SBATCH --partition=defq
#SBATCH --time=00:05:00
#SBATCH --ntasks=13
#SBATCH --cpus-per-task=6
#SBATCH --mem-per-cpu=100M
#SBATCH --output=task2_nonblocking_3x4-%j.out
#SBATCH --error=task2_nonblocking_3x4-%j.err

set -euo pipefail

module purge
module load openmpi/4.1.5-gcc-11.2.0-ux65npg

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
export OMP_DYNAMIC=FALSE

RESULT_DIR="newtask2output/task2_nonblocking/3x4/$SLURM_JOB_ID"
mkdir -p "$RESULT_DIR"

echo "========================================"
echo "TASK 2 NONBLOCKING - 3x4"
echo "Job ID: $SLURM_JOB_ID"
echo "MPI tasks: $SLURM_NTASKS"
echo "CPUs per task: $SLURM_CPUS_PER_TASK"
echo "Result directory: $RESULT_DIR"
echo "========================================"

echo
echo "=== COMPILING ==="

mpicc -O2 -std=c11 -fopenmp -Wall -Wextra \
    lab3_task2_nonblocking.c \
    -o task2_nonblocking

echo "Compilation successful."

echo
echo "=== TASK PLACEMENT ==="
srun hostname | sort | uniq -c

echo
echo "=== RUNNING 3x4 ==="
echo "rows=3 cols=4 ports=6 cycles=8 interval=1000 threshold=1 force_low=1 report_period=2000 seed=3143"

srun ./task2_nonblocking \
    3 4 \
    6 \
    8 \
    1000 \
    1 \
    1 \
    2000 \
    3143

echo
echo "=== COPYING LOGS ==="

if [ -f task2_nonblocking_base_station.log ]; then
    mv task2_nonblocking_base_station.log "$RESULT_DIR/"
fi

for f in task2_nonblocking_node_*.log; do
    if [ -e "$f" ]; then
        mv "$f" "$RESULT_DIR/"
    fi
done

# Copy the SLURM output/error into the result directory too.
cp "task2_nonblocking_3x4-$SLURM_JOB_ID.out" "$RESULT_DIR/" 2>/dev/null || true
cp "task2_nonblocking_3x4-$SLURM_JOB_ID.err" "$RESULT_DIR/" 2>/dev/null || true

echo
echo "=== RESULT FILES ==="
ls -lh "$RESULT_DIR"

echo
echo "Results saved to:"
echo "$RESULT_DIR"
